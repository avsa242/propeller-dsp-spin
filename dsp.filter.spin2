var

    ' high-pass filter
    long _hpf_prev_smp, _hpf_prev_out           ' working variables across calls


pub high_pass_filter_fo(s, a): o
' First-order high-pass filter: yₜ = ( xₜ - xₜ₋₁ ) + αyₜ₋₁
'   s:          current/new sample
'   a:          alpha (decay factor, filter aggressiveness), 0.0 .. 1.0 (float, clamped to range)
'   Returns:    filtered output
    if ( a <. 0.0 )                             ' clamp to range 0.0 .. 1.0
        a := 0.0
    if ( a >. 1.0 )
        a := 1.0

    o := round( (float(s) -. float(_hpf_prev_smp) ) +. a *. float(_hpf_prev_out) )

    _hpf_prev_smp := s                          ' record the current data as the new 'previous'
    _hpf_prev_out := o


dat
